.add-pill {
  --paper-texture: url("data:image/jpeg;base64,");
  box-sizing: border-box;
  display: inline-flex;
  width: auto;
  min-width: 132rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 3rpx solid #11100e;
  border-radius: 999rpx;
  color: #11100e;
  background: #f2be62 var(--paper-texture) repeat;
  background-size: 360rpx 360rpx;
  font-family: "Comic Sans MS", "Kaiti SC", serif;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 82rpx;
  letter-spacing: 0;
  white-space: nowrap;
}

.add-pill::after { border: 0; }

.add-pill:active {
  opacity: 0.78;
}

.add-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
}

.add-pill.is-primary { min-width:154rpx; background:#f2be62; }
