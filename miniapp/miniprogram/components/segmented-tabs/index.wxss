:host {
  display: block;
  width: 100%;
  height: 100rpx;
}

.segmented-tabs {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
  height: 100rpx;
  padding: 4rpx;
  overflow: hidden;
  border: 4rpx solid #292724;
  border-radius: 42rpx;
  background: #fffdf8;
}

.segmented-tabs.count-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.segmented-tab {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 31rpx;
  background: transparent;
  color: #28221b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.segmented-tab.is-selected {
  background: #f9c55e;
}
