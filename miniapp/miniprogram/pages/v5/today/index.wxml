<view class="page" wx:if="{{ready}}">
  <v5-topbar />
  <view class="content">
    <text class="small ink2 date">{{dateHeading}}</text>

    <view class="hero">
      <view class="name-row">
        <text class="name {{nameClass}}" hover-class="none" aria-role="button" aria-label="改名字和出生日期" bindtap="editBaby">{{name}}</text>
      </view>
      <text class="age title">{{ageLabel}}</text>
      <image class="hero-ill" src="{{illustration}}" mode="widthFix" aria-hidden="true" />
      <view class="lead">
        <text class="lead-main">{{lead}}</text>
        <text class="lead-sub small ink2">{{leadSub}}</text>
      </view>
    </view>

    <view wx:if="{{recent.length}}" class="section">
      <view class="section-title">
        <text class="title">这个月记的</text>
        <text class="small ink2">{{monthCount}} 条</text>
        <view class="section-spacer" />
        <v5-action kind="secondary" label="看看" bind:press="openRecords" />
      </view>
      <view class="section-body">
        <view wx:for="{{recent}}" wx:key="id" class="rec-row" hover-class="none" data-id="{{item.id}}" bindtap="openRecord">
          <view class="rec-main">
            <text class="item rec-text">{{item.text}}</text>
            <text class="small ink2">{{item.sub}}</text>
          </view>
          <text class="small ink2 rec-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="fab" hover-class="none" aria-role="button" aria-label="记一笔" bindtap="openQuick">
    <image class="fab-img" src="/assets/v5/fab-add.png" mode="aspectFit" aria-hidden="true" />
    <text class="fab-label">记一笔</text>
  </view>

  <v5-tabbar active="today" />
  <v5-quick-sheet open="{{sheetOpen}}" points="{{points}}" bind:close="closeSheet" bind:saved="onSaved" />
</view>
