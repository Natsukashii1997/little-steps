.page{
min-height:100vh;
background:#fbf4e8;
color:#24221e}
.health-page{
--health-tabs-region-height:119rpx}
.tabs-wrap{
position:fixed;
z-index:45;
top:142rpx;
right:0;
left:0;
box-sizing:border-box;
height:var(--health-tabs-region-height);
padding:6rpx 28rpx 13rpx;
background:#fbf4e8}
.page-scroll{
height:100vh;
box-sizing:border-box;
padding:0 28rpx}
.tabs-spacer{
height:var(--health-tabs-region-height)}
.health-hero{
position:relative;
box-sizing:border-box;
min-height:240rpx;
padding:27rpx 320rpx 24rpx 28rpx;
border:3rpx solid #b29d78;
border-radius:var(--card-radius);
background:rgba(255,252,244,.9);
overflow:hidden}
.hero-copy{
position:relative;
z-index:2;
min-width:0}
.hero-title{
display:block;
font-size:40rpx;
font-weight:900;
letter-spacing:2rpx;
max-width:100%;
overflow-wrap:anywhere;
white-space:normal}
.hero-subtitle{
display:block;
margin-top:10rpx;
color:#665f54;
font-size:23rpx;
line-height:1.4;
max-width:100%;
overflow-wrap:anywhere;
white-space:normal}
.hero-count{
display:block;
margin-top:25rpx;
color:#52713e;
font-size:23rpx;
font-weight:700;
max-width:100%;
overflow-wrap:anywhere;
white-space:normal}
.hero-art{
position:absolute;
right:165rpx;
bottom:18rpx;
width:150rpx;
height:176rpx}
.hero-secondary-art{
position:absolute;
z-index:1;
right:25rpx;
top:18rpx;
width:110rpx;
height:90rpx}
.hero-secondary-checkup{
width:100rpx;
height:106rpx}
.health-hero add-pill{
position:absolute;
z-index:2;
right:25rpx;
bottom:25rpx}
.vaccine-group{
margin-top:24rpx}
.group-heading{
display:flex;
align-items:center;
gap:16rpx;
margin:0 8rpx 13rpx}
.group-heading text{
padding:8rpx 20rpx;
border-radius:24rpx;
background:#f7e7bd;
font-size:26rpx;
font-weight:900}
.group-line{
flex:1;
border-top:3rpx dashed #b3a183}
.vaccine-card{
display:flex;
align-items:center;
min-height:130rpx;
margin-bottom:12rpx;
padding:14rpx 18rpx;
border:3rpx solid #b6a17d;
border-radius:var(--card-radius);
background:rgba(255,252,244,.91)}
.vaccine-icon{
flex:0 0 84rpx;
width:84rpx;
height:84rpx;
border-radius:50%}
.vaccine-info{
flex:1;
min-width:0;
padding:0 14rpx}
.vaccine-name{
display:block;
overflow:hidden;
text-overflow:ellipsis;
white-space:nowrap;
font-size:31rpx;
font-weight:900}
.dose-badge{
display:inline-block;
margin-top:7rpx;
padding:4rpx 12rpx;
border:2rpx dashed #a99662;
border-radius:14rpx;
background:#f7f1d9;
font-size:21rpx}
.vaccine-note{
display:block;
margin-top:4rpx;
overflow:hidden;
color:#746d60;
font-size:19rpx;
text-overflow:ellipsis;
white-space:nowrap}
.vaccine-status{
box-sizing:border-box;
display:flex;
flex:0 0 154rpx;
min-height:90rpx;
padding-left:14rpx;
flex-direction:column;
justify-content:center;
border-left:2rpx dashed #a8977d;
color:#2d5688;
font-size:20rpx;
line-height:1.45}
.vaccine-status>text:last-child{
font-size:18rpx;
letter-spacing:-.3rpx;
white-space:nowrap}
.vaccine-status.done{
color:#55723f}
.status-checkbox{
transform:scale(.78);
transform-origin:left center}
.status-checkbox.compact{
display:inline-block;
margin-right:-8rpx;
vertical-align:middle}
.timeline{
margin-top:28rpx}
.timeline-row{
position:relative;
display:flex;
min-height:276rpx;
padding-left:40rpx;
margin-bottom:22rpx}
.timeline-line{
position:absolute;
top:-14rpx;
bottom:-28rpx;
left:13rpx;
border-left:3rpx dashed #ab9b77}
.timeline-dot{
position:absolute;
top:34rpx;
left:-11rpx;
width:18rpx;
height:18rpx;
border:4rpx solid #968557;
border-radius:50%;
background:#e4e1bd}
.ability-card,.checkup-card{
position:relative;
display:flex;
align-items:center;
box-sizing:border-box;
width:100%;
min-height:276rpx;
padding:24rpx 60rpx 24rpx 20rpx;
border:3rpx solid #b6a17d;
border-radius:var(--card-radius);
background:rgba(255,252,244,.91)}
.ability-image{
flex:0 0 210rpx;
width:210rpx;
height:166rpx;
border-radius:22rpx}
.ability-copy,.checkup-copy{
flex:1;
min-width:0;
padding-left:20rpx}
.date-chip{
display:inline-block;
padding:5rpx 16rpx;
border-radius:19rpx;
background:#e8e4c9;
font-size:20rpx}
.date-chip.blue{
background:#dceaf5}
.ability-name{
display:block;
margin-top:9rpx;
font-size:34rpx;
font-weight:900}
.ability-desc{
display:block;
margin-top:7rpx;
color:#645d52;
font-size:21rpx;
line-height:1.45}
.arrow{
position:absolute;
right:19rpx;
top:50%;
width:38rpx;
height:38rpx;
transform:translateY(-50%)}
.warm-note{
margin:10rpx 8rpx 0;
padding:21rpx;
border:3rpx solid #d1b980;
border-radius:23rpx;
background:#fff3d8;
color:#65563a;
font-size:22rpx}
.calendar-mark{
flex:0 0 210rpx;
width:210rpx;
height:210rpx}
.check-status{
display:flex;
width:max-content;
margin-top:8rpx;
padding:4rpx 12rpx;
align-items:center;
border:2rpx dashed #96adc1;
border-radius:15rpx;
color:#426b96;
font-size:21rpx}
.check-status.done{
border-color:#9eaa6d;
color:#55723f}
.bottom-space{
height:calc(160rpx + constant(safe-area-inset-bottom));
height:calc(160rpx + env(safe-area-inset-bottom))}
.modal-mask{
position:fixed;
z-index:100;
inset:0;
display:flex;
align-items:flex-end;
background:rgba(31,28,23,.42)}
.editor-sheet{
box-sizing:border-box;
width:100%;
max-height:88vh;
padding:18rpx 32rpx calc(42rpx + constant(safe-area-inset-bottom));
padding-bottom:calc(42rpx + env(safe-area-inset-bottom));
overflow-y:auto;
border:3rpx solid #292724;
border-bottom:0;
border-radius:44rpx 38rpx 0 0;
background:var(--paper) var(--paper-texture) repeat;
background-size:360rpx 360rpx}
.sheet-handle{
width:70rpx;
height:8rpx;
margin:0 auto 18rpx;
border-radius:8rpx;
background:#bdb29d}
.sheet-title-row{
display:flex;
align-items:center;
justify-content:space-between;
margin-bottom:21rpx}
.sheet-title{
font-size:36rpx;
font-weight:900}
.sheet-close{
width:auto;
min-width:88rpx;
min-height:var(--control-height);
padding:0 12rpx;
background:transparent;
color:#5d574f;
font-size:24rpx;
line-height:82rpx}
.vaccine-editor-name{
margin:-3rpx 0 20rpx;
color:#57713e;
font-size:29rpx;
font-weight:900}
.vaccine-editor-name text{
margin-left:10rpx;
color:#7c735d;
font-size:21rpx}
.field{
margin-bottom:19rpx}
.field>text{
display:block;
margin-bottom:9rpx;
font-size:25rpx;
font-weight:800}
.field input,.field textarea,.picker-value{
box-sizing:border-box;
width:100%;
min-height:var(--control-height);
padding:19rpx 20rpx;
border:3rpx solid #292724;
border-radius:var(--field-radius);
background:rgba(255,253,248,.82);
font-size:25rpx}
.field textarea{
height:150rpx;
line-height:1.5}
.picker-value{
display:flex;
align-items:center;
justify-content:space-between}
.picker-chevron{
width:30rpx;
height:30rpx;
transform:rotate(90deg)}
.complete-toggle{
display:flex;
min-height:var(--control-height);
align-items:center;
gap:12rpx;
margin:9rpx 0 18rpx;
padding:16rpx;
border-radius:var(--field-radius);
background:#f8f2df;
font-size:25rpx;
font-weight:800}
.complete-toggle .status-checkbox{
transform:scale(.9)}
.media-button{
width:100%;
min-height:var(--control-height);
margin:0 0 15rpx;
padding:18rpx;
border:3rpx dashed #9b8b68;
border-radius:var(--field-radius);
background:rgba(255,250,240,.78);
color:#5a6642;
font-size:25rpx}
.upload-preview{
width:160rpx;
height:160rpx;
margin:0 0 15rpx;
border-radius:18rpx}
.save-button,.delete-button{
width:100%;
min-height:var(--control-height);
margin-top:10rpx;
border:3rpx solid #292724;
border-radius:999rpx;
font-size:28rpx;
font-weight:900}
.save-button{
background:#f9c653}
.delete-button{
background:#fff0eb;
color:#c85d45}

/* Keep dynamic pages on the same warm paper as Home and respect iPhone safe areas. */
.page,
.tabs-wrap {

  background: #f6eee3 var(--paper-texture) repeat;

  background-size: 360rpx 360rpx;

}

.check-status {
 display: inline-flex;
 width: auto;
 max-width: 100%;
 }

.bottom-space {
 height: calc(160rpx + constant(safe-area-inset-bottom));
 height: calc(160rpx + env(safe-area-inset-bottom));
 }

@media (max-width: 360px) {
 .tabs-wrap { padding-right: 24rpx; padding-left: 24rpx; }
 .page-scroll { padding-right: 24rpx; padding-left: 24rpx; }
 .health-hero { padding-right: 294rpx; padding-left: 22rpx; }
 .hero-title { font-size: 36rpx; letter-spacing: 1rpx; }
 .hero-subtitle,.hero-count { font-size: 21rpx; }
 .hero-art { right: 150rpx; width: 138rpx; }
 .hero-secondary-art { right: 22rpx; width: 96rpx; }
 .vaccine-card { padding-right: 14rpx; padding-left: 14rpx; }
 .vaccine-info { padding-right: 10rpx; padding-left: 10rpx; }
 .vaccine-status { flex-basis: 146rpx; padding-left: 10rpx; }
 .ability-card,.checkup-card { padding-left: 16rpx; }
 .ability-copy,.checkup-copy { padding-left: 14rpx; }
 .editor-sheet { padding-right: 24rpx; padding-left: 24rpx; }
}

/* Vaccine list: name first, state second, date on its own readable line. */
.vaccine-card { position:relative; align-items:flex-start; padding:24rpx 18rpx; }
.vaccine-icon { flex:0 0 72rpx; width:72rpx; height:72rpx; margin-top:6rpx; }
.vaccine-info { padding:0 12rpx 0 16rpx; }
.vaccine-title-row { display:flex; align-items:baseline; justify-content:space-between; gap:12rpx; }
.vaccine-name { overflow:visible; white-space:normal; line-height:1.35; font-size:31rpx; }
.vaccine-status { display:block; flex:0 0 auto; min-height:0; padding:0; border:0; font-size:23rpx; white-space:nowrap; color:#746b5f; }
.vaccine-status.done { color:#4c6837; }
.dose-badge { margin-top:9rpx; font-size:23rpx; }
.vaccine-date { display:block; margin-top:13rpx; color:#514c43; font-size:25rpx; line-height:1.5; }
.vaccine-note { margin-top:7rpx; font-size:23rpx; white-space:normal; line-height:1.45; overflow:visible; }
.vaccine-chevron { flex:0 0 25rpx; width:25rpx; height:30rpx; margin-top:7rpx; }
.vaccine-pressed { opacity:.78; }
.current-age-group .group-heading > text:first-child { background:#f2be62; }
.group-heading .current-age-label { background:transparent; padding:0; color:#5f6f45; font-size:23rpx; font-weight:400; }
.current-age-group .group-line { border-top-color:#af893f; }
.vaccine-editor .field > text { font-size:27rpx; }
.vaccine-editor .field input,.vaccine-editor .picker-value { font-size:30rpx; min-height:92rpx; border-width:2rpx; }
.vaccine-editor .complete-toggle { min-height:92rpx; padding:12rpx 18rpx; background:#e8edda; border-radius:20rpx; }
.vaccine-editor .complete-toggle + .field { margin-top:16rpx; padding:16rpx; background:#eef0e4; border-radius:20rpx; }

.vaccine-editor { padding:18rpx 32rpx calc(42rpx + env(safe-area-inset-bottom)); }
