.report-content {
  padding-right: 26rpx;
  padding-bottom: calc(188rpx + var(--safe-bottom));
  padding-left: 26rpx;
}

.report-hero {
  position: relative;
  min-height: 306rpx;
  padding: 34rpx 31rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  width: 68%;
  flex-direction: column;
}

.hero-eyebrow {
  color: var(--red);
  font-family: "Comic Sans MS", "Kaiti SC", serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 9rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.hero-description {
  margin-top: 13rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.46;
}

.privacy-pill {
  display: flex;
  width: fit-content;
  max-width: 100%;
  min-height: 50rpx;
  padding: 6rpx 15rpx;
  margin-top: 17rpx;
  align-items: center;
  gap: 9rpx;
  border: 2rpx dashed rgba(107, 129, 76, 0.7);
  border-radius: 999rpx;
  color: #53683d;
  background: rgba(222, 226, 193, 0.58);
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.privacy-pill text:last-child { min-width: 0; }

.privacy-shield {
  font-size: 25rpx;
  font-weight: 700;
}

.hero-note {
  position: absolute;
  z-index: 1;
  top: 51rpx;
  right: 26rpx;
  display: flex;
  width: 176rpx;
  height: 190rpx;
  padding: 38rpx 20rpx 18rpx;
  transform: rotate(3deg);
  flex-direction: column;
  align-items: center;
  border: 3rpx solid var(--ink);
  border-radius: 11rpx 16rpx 9rpx 14rpx;
  background: rgba(250, 210, 123, 0.72) var(--paper-texture) repeat;
  background-size: 360rpx 360rpx;
  box-shadow: 7rpx 8rpx 0 rgba(92, 131, 168, 0.13);
}

.hero-note::before {
  position: absolute;
  top: -13rpx;
  left: 49rpx;
  width: 77rpx;
  height: 27rpx;
  transform: rotate(-2deg);
  background: rgba(235, 226, 202, 0.82);
  content: "";
}

.hero-note-line {
  width: 100%;
  margin-bottom: 17rpx;
  border-top: 2rpx dashed rgba(17, 16, 14, 0.48);
}

.hero-note-line.short { width: 64%; }
.hero-note-line.medium { width: 82%; }

.hero-note text {
  margin-top: 3rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-spark {
  position: absolute;
  z-index: 3;
  color: var(--blue);
  font-size: 32rpx;
}

.spark-one { top: 20rpx; right: 214rpx; }
.spark-two { right: 18rpx; bottom: 28rpx; color: var(--orange); }

.section-heading {
  display: flex;
  min-height: 70rpx;
  margin: 26rpx 5rpx 12rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 13rpx;
}

.section-number {
  display: grid;
  width: 54rpx;
  height: 54rpx;
  place-items: center;
  border: 2rpx solid var(--ink);
  border-radius: 50%;
  color: var(--red);
  background: rgba(255, 251, 241, 0.72);
  font-family: "Comic Sans MS", "Kaiti SC", serif;
  font-size: 20rpx;
  font-weight: 700;
}

.section-heading-title {
  font-size: 33rpx;
  font-weight: 700;
}

.section-hint {
  flex: 0 0 auto;
  color: var(--muted);
  font-size: 22rpx;
}

.date-card {
  display: grid;
  min-height: 164rpx;
  padding: 23rpx;
  grid-template-columns: minmax(0, 1fr) 42rpx minmax(0, 1fr);
  align-items: center;
}

.date-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.date-label {
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.date-value {
  display: flex;
  min-height: 88rpx;
  padding: 0 15rpx;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border-bottom: 3rpx solid var(--ink);
  font-family: "Comic Sans MS", "Kaiti SC", serif;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.date-arrow {
  color: var(--orange);
  font-size: 30rpx;
}

.date-dash {
  align-self: end;
  padding-bottom: 23rpx;
  text-align: center;
  color: var(--muted);
}

.module-card {
  padding: 8rpx 22rpx;
  overflow: hidden;
}

.module-option {
  display: grid;
  min-height: 120rpx;
  padding: 17rpx 4rpx;
  grid-template-columns: 58rpx minmax(0, 1fr) 64rpx;
  align-items: center;
  gap: 11rpx;
  border-bottom: 2rpx dashed var(--line);
}

.module-option:last-child { border-bottom: 0; }

.module-option.is-selected {
  margin: 0 -10rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
  border-radius: 22rpx 19rpx 24rpx 20rpx;
  background: rgba(232, 224, 188, 0.46);
}

.module-checkbox {
  transform: scale(0.86);
  transform-origin: center;
}

.module-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.module-title {
  font-size: 29rpx;
  font-weight: 700;
}

.module-description {
  overflow: hidden;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-state {
  color: var(--muted);
  font-size: 21rpx;
  text-align: right;
}

.module-option.is-selected .module-state {
  color: #53683d;
  font-weight: 700;
}

.report-error {
  display: flex;
  min-height: 74rpx;
  padding: 13rpx 18rpx;
  margin-top: 18rpx;
  align-items: center;
  gap: 13rpx;
  border: 2rpx dashed var(--red);
  border-radius: 18rpx;
  color: #9a493f;
  background: rgba(239, 109, 80, 0.09);
  font-size: 23rpx;
  line-height: 1.4;
}

.error-mark {
  display: grid;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  place-items: center;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-weight: 700;
}

.report-generate {
  width: 100%;
  margin-top: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.generate-caption {
  display: block;
  margin-top: 11rpx;
  text-align: center;
  color: var(--muted);
  font-size: 21rpx;
}

.result-card {
  padding: 25rpx;
  margin-top: 26rpx;
}

.result-heading {
  display: flex;
  align-items: center;
  gap: 17rpx;
}

.result-check {
  display: grid;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  place-items: center;
  border: 3rpx solid var(--ink);
  border-radius: 18rpx 15rpx 19rpx 16rpx;
  color: #53683d;
  background: rgba(204, 215, 166, 0.75);
  font-size: 32rpx;
  font-weight: 700;
}

.result-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.result-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.result-actions {
  display: grid;
  margin-top: 21rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.result-action {
  min-width: 0;
  min-height: 88rpx;
  padding: 0 7rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: rgba(255, 251, 241, 0.8);
  font-size: 22rpx;
  line-height: 84rpx;
}

.result-action.is-primary {
  background: var(--yellow) var(--paper-texture) repeat;
  background-size: 360rpx 360rpx;
  font-weight: 700;
}

.report-footnote {
  display: grid;
  margin: 28rpx 0 4rpx;
  grid-template-columns: minmax(24rpx, 1fr) auto minmax(24rpx, 1fr);
  align-items: center;
  gap: 12rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.footnote-line { border-top: 2rpx dashed var(--line); }

.report-canvas {
  position: fixed;
  z-index: -1;
  top: 0;
  left: -10000px;
  width: 345px;
  pointer-events: none;
  opacity: 0;
}

@media (max-width: 360px) {
  .report-content { padding-right: 22rpx; padding-left: 22rpx; }
  .report-hero { min-height: 322rpx; padding: 28rpx; }
  .hero-copy { width: 100%; }
  .hero-note { display: none; }
  .hero-title { font-size: 37rpx; }
  .privacy-pill { white-space: normal; }
  .date-card { padding-right: 14rpx; padding-left: 14rpx; }
  .date-value { padding-right: 8rpx; padding-left: 8rpx; font-size: 22rpx; }
  .result-actions { grid-template-columns: 1fr; }
}
