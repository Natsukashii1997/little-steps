.memory-content {
  padding-top: 132rpx;
}

.memory-hero {
  position: relative;
  display: grid;
  min-height: 280rpx;
  padding: 30rpx 28rpx;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.eyebrow {
  color: #a46c56;
  font-family: "Comic Sans MS", "Kaiti SC", serif;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 7rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.24;
}

.hero-subtitle {
  margin-top: 11rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.hero-count {
  margin-top: 20rpx;
  color: #526b39;
  font-size: 25rpx;
  font-weight: 700;
}

.hero-bear {
  position: absolute;
  right: -8rpx;
  bottom: -18rpx;
  width: 172rpx;
  height: 172rpx;
}

.memory-hero add-pill {
  position: absolute;
  z-index: 3;
  right: 20rpx;
  top: 20rpx;
}

.memory-filters {
  display: grid;
  margin: 22rpx 0;
  padding: 6rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: rgba(255, 251, 241, 0.64);
}

.filter-button {
  min-width: 0;
  min-height: var(--control-height);
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: transparent;
  font-size: 27rpx;
  line-height: 82rpx;
}

.filter-button.is-active {
  background: var(--yellow) var(--paper-texture) repeat;
  background-size: 360rpx 360rpx;
  font-weight: 700;
}

.memory-feed {
  display: grid;
  gap: 18rpx;
}

.memory-card {
  width: 100%;
  padding: 0;
  overflow: hidden;
  text-align: left;
  line-height: 1.35;
}

.photo-card {
  display: grid;
  padding: 22rpx;
  grid-template-columns: 270rpx minmax(0, 1fr);
  align-items: center;
  gap: 24rpx;
}

.photo-frame {
  position: relative;
  padding: 12rpx 12rpx 48rpx;
  transform: rotate(-1deg);
  background: #fffaf0;
  box-shadow: 0 6rpx 16rpx rgba(77, 59, 40, 0.14);
}

.memory-photo {
  width: 100%;
  height: 220rpx;
  background: #eadfc8;
}

.photo-tape {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 100%;
  transform: translateX(-50%);
  text-align: center;
  color: var(--muted);
  font-size: 20rpx;
}

.photo-count {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  padding: 5rpx 12rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  color: var(--ink);
  background: rgba(255, 200, 91, 0.94);
  font-size: 18rpx;
  font-weight: 700;
}

.photo-copy,
.story-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.card-label-row {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.type-label {
  padding: 5rpx 15rpx;
  border-radius: 999rpx;
  color: #6a4b36;
  background: rgba(242, 190, 98, 0.55);
  font-size: 22rpx;
}

.edit-hint,
.memory-date {
  color: var(--muted);
  font-size: 20rpx;
  white-space: nowrap;
}

.edit-hint { display: flex; align-items: center; gap: 3rpx; }
.edit-hint image { width: 20rpx; height: 20rpx; }

.card-title {
  display: block;
  width: 100%;
  margin-top: 13rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.card-description {
  display: -webkit-box;
  width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #544b40;
  font-size: 24rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.story-card {
  position: relative;
  display: grid;
  min-height: 234rpx;
  padding: 22rpx 50rpx 22rpx 20rpx;
  grid-template-columns: 190rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
}

.story-card.yellow { background-color: rgba(255, 244, 209, 0.68); }
.story-card.sage { background-color: rgba(228, 232, 207, 0.68); }
.story-card.blue { background-color: rgba(218, 232, 241, 0.62); }

.story-art image {
  width: 180rpx;
  height: 180rpx;
}

.story-rule {
  width: 100%;
  height: 2rpx;
  margin-top: 11rpx;
  border-top: 2rpx dashed var(--line);
}

.health-linked {
  margin-top: 11rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #526b39;
  background: rgba(220, 227, 191, 0.72);
  font-size: 20rpx;
}

.audio-memory-button {
  display: flex;
  width: 100%;
  min-height: 70rpx;
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid var(--ink);
  border-radius: 20rpx;
  background: rgba(255, 251, 241, 0.8);
  font-size: 22rpx;
  font-weight: 700;
}

.audio-memory-button.is-playing { background: rgba(255, 200, 91, 0.8); }
.audio-memory-name {
  min-width: 0;
  overflow: hidden;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-chevron {
  position: absolute;
  right: 18rpx;
  top: 50%;
  width: 26rpx;
  height: 38rpx;
  transform: translateY(-50%);
}

.empty-book {
  display: flex;
  min-height: 430rpx;
  padding: 32rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 34rpx;
}

.empty-book image {
  width: 210rpx;
  height: 180rpx;
}

.empty-book .muted {
  font-size: 24rpx;
}

.memory-editor {
  height: 90vh;
  max-height: 90vh;
}

.content-rule {
  display: flex;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  flex-direction: column;
  gap: 4rpx;
  border-left: 7rpx solid #d99a36;
  border-radius: 0 18rpx 18rpx 0;
  color: #5d5244;
  background: rgba(255, 232, 181, 0.5);
  font-size: 22rpx;
}

.media-field { gap: 14rpx; }

.media-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.media-count {
  color: var(--muted);
  font-size: 22rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.draft-photo {
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(32, 30, 26, 0.5);
  border-radius: 22rpx;
  background: #eadfc8;
}

.draft-photo image {
  display: block;
  width: 100%;
  height: 174rpx;
}

.remove-media {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  min-width: 74rpx;
  min-height: 48rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  color: #fffaf0;
  background: rgba(32, 30, 26, 0.84);
  font-size: 18rpx;
  line-height: 44rpx;
}

.media-add-button {
  display: flex;
  width: 100%;
  min-height: 116rpx;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  border: 3rpx dashed #8b754d;
  border-radius: 26rpx;
  color: #574d40;
  background: rgba(255, 251, 241, 0.7);
  font-size: 27rpx;
  text-align: left;
}

.media-add-button image {
  width: 48rpx;
  height: 48rpx;
}

.media-add-button > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.upload-help {
  display: block;
  color: var(--muted);
  font-size: 20rpx;
}

.media-divider {
  display: grid;
  margin: 4rpx 0 22rpx;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.media-divider view { border-top: 2rpx dashed var(--line); }

.audio-mark {
  display: inline-flex;
  min-width: 84rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: rgba(198, 218, 235, 0.76);
  font-size: 20rpx;
  font-weight: 700;
}

.audio-selected {
  display: flex;
  min-height: 112rpx;
  padding: 18rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 2rpx solid var(--ink);
  border-radius: 24rpx;
  background: rgba(218, 232, 241, 0.62);
}

.audio-selected > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.audio-selected-title { font-size: 25rpx; font-weight: 700; }
.audio-selected-name {
  max-width: 420rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-audio {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: #fffaf0;
  font-size: 22rpx;
  line-height: 60rpx;
}

.choice-tip {
  color: #9a5f4f;
  font-size: 20rpx;
}

@media (max-width: 360px) {
  .memory-hero { grid-template-columns: minmax(0, 1fr) 150rpx; }
  .hero-title { font-size: 36rpx; }
  .memory-filters {
    margin-top: 18rpx;
    margin-bottom: 18rpx;
  }
  .filter-button { font-size: 24rpx; }
  .photo-card { grid-template-columns: 230rpx minmax(0, 1fr); gap: 18rpx; }
  .memory-photo { height: 190rpx; }
  .story-card { grid-template-columns: 164rpx minmax(0, 1fr); }
  .story-art image { width: 158rpx; height: 158rpx; }
}
