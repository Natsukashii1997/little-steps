<view class="page-shell">
  <app-header title="{{dateHeading}}" home="{{true}}" show-notice="{{true}}" notice-unread="{{reminders.length > 0}}" bind:notice="openNotices" />

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-content home-content" style="padding-top: {{headerHeight + 12}}px;">
      <button class="family-sync-strip" bindtap="openSync">
        <text>个人云同步</text>
        <text class="sync-state {{syncInfo.error ? 'has-error' : ''}} {{syncConflict.count ? 'has-conflict' : ''}}">{{syncInfo.pending ? '同步中' : (syncInfo.error ? '同步失败 · 记录仍在本机' : (syncConflict.count ? '发现 ' + syncConflict.count + ' 项冲突' : (syncInfo.family ? '已同步' : '未开启')))}}</text>
      </button>
      <view class="home-hero paper-card">
        <view class="avatar-stage" wx:if="{{canChangeAvatar}}">
          <button class="avatar-button {{uploadingAvatar ? 'is-saving' : ''}}" bindtap="changeAvatar" disabled="{{uploadingAvatar}}" aria-label="点击圆形照片更换硕之的头像">
            <image class="baby-avatar" src="{{avatarSrc}}" mode="aspectFill" />
          </button>
        </view>
        <view class="avatar-stage" wx:else>
          <view class="avatar-button" aria-label="硕之的头像">
            <image class="baby-avatar" src="{{avatarSrc}}" mode="aspectFill" />
          </view>
        </view>
        <view class="hero-copy">
          <view class="baby-name-row">
            <text class="baby-name">硕之</text>
            <image class="heart-mark" src="/assets/ui/heart.png" mode="aspectFit" />
          </view>
          <text class="baby-age">{{ageLabel}}</text>
          <text class="hero-tagline">Growing beautifully!</text>
        </view>

        <view class="metrics-row">
          <button class="metric" bindtap="openGrowthEditor" aria-label="填写体重测量">
            <image src="/assets/care/icon-weight.png" mode="aspectFit" />
            <view class="metric-copy"><text>体重</text><view class="metric-value">{{weight}} <text class="metric-unit">kg</text></view><text class="metric-birth">{{weightSource}}</text></view>
          </button>
          <button class="metric" bindtap="openGrowthEditor" aria-label="填写身高测量">
            <image src="/assets/care/icon-height.png" mode="aspectFit" />
            <view class="metric-copy"><text>身高</text><view class="metric-value">{{height}} <text class="metric-unit">cm</text></view><text class="metric-birth">{{heightSource}}</text></view>
          </button>
          <button class="metric age-metric" bindtap="openGrowthEditor" aria-label="当前月龄">
            <image src="/assets/care/icon-age.png" mode="aspectFit" />
            <view class="metric-copy"><text>当前月龄</text><view class="metric-value">{{ageMonths}} <text class="metric-unit">个月</text></view><text class="metric-birth">{{ageDays}}天</text></view>
          </button>
        </view>
      </view>

      <view class="care-grid" aria-label="今日最新记录">
        <view class="care-card paper-card" data-kind="feeding" bindtap="openManager" hover-class="care-pressed" role="button" aria-label="查看喂养记录">
          <view class="care-head">
            <image src="/assets/care/icon-feeding.png" mode="aspectFit" />
            <view class="care-title"><text class="care-name feeding-title">喂养</text><text>上次喂奶</text><text class="warm-value">{{feeding.relative}}</text></view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
          <view class="care-divider" />
          <view class="feeding-details" wx:if="{{feeding.hasRecord}}">
            <view class="feeding-detail-row"><view class="dot coral" /><text>时间：</text><text class="detail-value">{{feeding.time}}</text></view>
            <view class="feeding-detail-row"><view class="dot blue" /><text>奶量：</text><text class="detail-value">{{feeding.amount}}</text></view>
            <view class="feeding-detail-row"><view class="dot yellow" /><text>类型：</text><text class="detail-value">{{feeding.milkType}}</text></view>
          </view>
          <text class="care-empty" wx:else>点此添加喂养记录</text>
        </view>

        <view class="care-card paper-card" data-kind="sleep" bindtap="openManager" hover-class="care-pressed" role="button" aria-label="查看睡眠记录">
          <view class="care-head">
            <image src="/assets/care/icon-sleep.png" mode="aspectFit" />
            <view class="care-title"><text class="care-name sleep-title">睡眠</text><text>最近睡眠</text><text class="warm-value">{{sleep.range}}</text></view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
          <view class="care-divider" />
          <view class="two-column-row sleep-total"><text>今日时长</text><text class="sleep-total-value">{{sleep.total}}</text></view>
        </view>

        <view class="care-card compact-card paper-card" data-kind="diaper" bindtap="openManager">
          <view class="care-head compact-head">
            <image src="/assets/care/icon-diaper.png" mode="aspectFit" />
            <view class="care-title"><text class="care-name diaper-title">换尿布</text><text>最新记录</text><text class="warm-value">{{diaper.latest}}</text></view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
          <view class="care-divider" />
          <view class="two-column-row quick-row">
            <view class="quick-summary" aria-label="今日 {{diaper.count}} 次"><text>今日</text><text class="quick-emphasis">{{diaper.count}}</text><text>次</text></view>
            <button class="check-action" catchtap="quickDiaper"><image class="quick-add-icon" src="/assets/icons/plus.svg" mode="aspectFit" /><text>记录</text></button>
          </view>
        </view>

        <view class="care-card compact-card paper-card" data-kind="poop" bindtap="openManager">
          <view class="care-head compact-head">
            <image src="/assets/care/icon-poop.png" mode="aspectFit" />
            <view class="care-title"><text class="care-name poop-title">便便</text><text>最新记录</text><text class="warm-value">{{poop.latest}}</text></view>
            <image class="chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
          <view class="care-divider" />
          <view class="two-column-row quick-row">
            <view class="quick-summary" aria-label="今日 {{poop.count}} 次"><text>今日</text><text class="quick-emphasis">{{poop.count}}</text><text>次</text></view>
            <button class="check-action" catchtap="quickPoop"><image class="quick-add-icon" src="/assets/icons/plus.svg" mode="aspectFit" /><text>记录</text></button>
          </view>
        </view>

        <view class="care-card health-wide paper-card">
          <view class="care-head compact-head">
            <image src="/assets/care/icon-health.png" mode="aspectFit" />
            <view class="care-title"><text class="care-name health-title">健康</text><view class="inline-summary"><text>Vitamin D</text></view></view>
            <view class="chevron-spacer" />
          </view>
          <view class="care-divider" />
          <view class="two-column-row quick-row health-quick-row">
            <view class="quick-summary" aria-label="{{vitamin.completed ? '今日已服用' : '今日未服用'}}"><text>今日</text><text class="quick-emphasis">{{vitamin.completed ? '已' : '未'}}</text><text>服用</text></view>
            <button class="check-action vitamin-action {{vitamin.completed ? 'is-confirmed' : ''}}" catchtap="toggleVitamin" aria-label="{{vitamin.completed ? '取消今日服用确认' : '确认今日已服用'}}"><text>{{vitamin.completed ? '取消确认' : '确认服用'}}</text></button>
          </view>
        </view>
      </view>

      <view class="todo-card paper-card {{!todos.length ? 'is-empty' : ''}}">
        <view class="todo-heading"><text>Today's To-do</text><add-pill primary="{{true}}" bind:add="openTodoEditor" /></view>
        <view class="todo-list">
          <view class="todo-row" wx:for="{{todos}}" wx:key="id">
            <button class="todo-check-button" data-id="{{item.id}}" bindtap="toggleTodo" aria-label="{{item.completed ? '标记为未完成' : '标记为已完成'}}"><checkbox class="native-check" disabled checked="{{item.completed}}" color="#aab57a" /></button>
            <button class="todo-title {{item.completed ? 'is-complete' : ''}}" data-id="{{item.id}}" bindtap="openTodoEditor">{{item.title}}</button>
            <button class="todo-delete" data-id="{{item.id}}" bindtap="deleteTodo" aria-label="删除待办">删除</button>
          </view>
          <view wx:if="{{!todos.length}}" class="empty-state">还没有待办，点 Add 添加一项。</view>
        </view>
        <image class="todo-bear" src="/assets/home/todo-bear.png" mode="aspectFit" />
      </view>

      <button class="report-entry paper-card" bindtap="openReport" aria-label="分享成长摘要">
        <view class="report-entry-copy">
          <text class="report-entry-eyebrow">SHARE A LITTLE MOMENT</text>
          <text class="report-entry-title">分享成长摘要</text>
          <text class="report-entry-description">自己选择内容，只分享想分享的部分。</text>
        </view>
        <view class="report-entry-action"><text>生成长图</text><image class="report-entry-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
      </button>
    </view>
  </scroll-view>

  <undo-bar
    visible="{{undoVisible}}"
    message="{{undoMessage}}"
    token="{{undoToken}}"
    bind:undo="undoLastDelete"
    bind:expired="onUndoExpired"
  />
  <app-tabbar active-page="home" />

  <view wx:if="{{noticeOpen}}" class="sheet-mask" bindtap="closeNotices">
    <scroll-view class="sheet-panel notice-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop">
      <view class="sheet-handle" />
      <view class="sheet-heading"><text>提醒</text><button class="sheet-close" bindtap="closeNotices">关闭</button></view>
      <text class="notice-intro">只显示已到期和未来 14 天内需要处理的事项。</text>
      <view wx:if="{{!reminders.length}}" class="empty-state notice-empty">目前没有待处理提醒。</view>
      <button
        class="reminder-item paper-card"
        wx:for="{{reminders}}"
        wx:key="key"
        data-type="{{item.type}}"
        data-id="{{item.id}}"
        bindtap="openReminder"
      >
        <text class="reminder-type">{{item.typeLabel}}</text>
        <view class="reminder-copy"><text class="reminder-title">{{item.title}}</text><text class="reminder-meta">{{item.meta}}</text></view>
        <image class="reminder-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </button>
    </scroll-view>
  </view>

  <view wx:if="{{syncOpen}}" class="sheet-mask" bindtap="closeSync">
    <scroll-view class="sheet-panel sync-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop">
      <view class="sheet-handle" />
      <view class="sheet-heading"><text>个人云同步</text><button class="sheet-close" bindtap="closeSync">关闭</button></view>
      <view wx:if="{{syncInfo.family}}" class="family-connected paper-card">
        <view class="family-summary">
          <view><text class="family-title">个人云同步</text><text class="family-member-count">记录已保存在本机和个人私密云空间</text></view>
          <text class="family-role">{{syncInfo.pending ? '同步中' : (syncInfo.error ? '同步失败 · 记录仍在本机' : (syncConflict.count ? '请核对冲突' : '已同步'))}}</text>
        </view>

        <view wx:if="{{syncConflict.count}}" class="sync-conflict-card">
          <view class="sync-conflict-heading"><text>发现 {{syncConflict.count}} 项同步冲突</text><text>请核对</text></view>
          <text class="sync-conflict-guidance">{{syncConflict.guidance}}</text>
          <view wx:for="{{syncConflict.items}}" wx:key="id" class="sync-conflict-item">
            <text class="sync-conflict-title">{{item.title}}</text>
            <text>{{item.result}}</text>
            <text class="sync-conflict-overwritten">{{item.overwritten}}</text>
          </view>
          <text wx:if="{{syncConflict.count > syncConflict.items.length}}" class="sync-conflict-more">另有 {{syncConflict.count - syncConflict.items.length}} 项，请在对应记录中核对。</text>
        </view>

        <button class="ink-button sync-button" bindtap="syncNow">立即同步</button>

        <view wx:if="{{capacityView}}" class="capacity-card {{capacityView.warning ? 'is-warning' : ''}}">
          <view class="capacity-summary"><text>云端数据容量</text><text>{{capacityView.percent}}%</text></view>
          <view class="capacity-track"><view class="capacity-fill" style="width: {{capacityView.percent}}%;" /></view>
          <text class="capacity-meta">{{capacityView.used}} / {{capacityView.limit}}{{capacityView.warning ? ' · 建议尽快导出存档' : ''}}</text>
        </view>

        <text class="backup-owner-note backup-explanation">个人云备份保存全部个人记录和照片、音频的引用；实际照片和音频文件仍保存在云存储。成长摘要长图只包含你当次勾选的内容，两者互不替代。</text>
        <view class="data-tool-row">
          <button wx:if="{{syncInfo.family.owner}}" class="secondary-pill backup-create-button" disabled="{{backupActionId || backupLoading}}" bindtap="createManualBackup">{{backupActionId === 'create' ? '正在备份' : '立即备份'}}</button>
          <button class="secondary-pill" disabled="{{exportLoading}}" loading="{{exportLoading}}" bindtap="exportFamilyData">{{exportLoading ? '正在导出' : '导出离线存档'}}</button>
          <button class="secondary-pill" disabled="{{backupLoading}}" bindtap="loadBackups">{{backupLoading ? '刷新中' : '刷新备份'}}</button>
        </view>
        <text class="backup-owner-note">导出存档仅供离线保存，当前不能直接导入恢复。</text>

        <view class="backup-section">
          <view class="backup-heading"><text>最近备份</text><text>最多保留 {{backupRetention}} 份</text></view>
          <text wx:if="{{backupLoading && !backups.length}}" class="backup-state">正在读取备份…</text>
          <view wx:elif="{{backupError}}" class="backup-error-row"><text>{{backupError}}</text><button class="backup-retry-button" bindtap="loadBackups">重试</button></view>
          <text wx:elif="{{!backups.length}}" class="backup-state">同步一次后，这里会出现可恢复的备份。</text>
          <view wx:for="{{backups}}" wx:key="backupId" class="backup-item">
            <view class="backup-copy">
              <text class="backup-title">{{item.reasonLabel}} · 版本 {{item.version}}</text>
              <text class="backup-meta">{{item.dateLabel}} · {{item.sizeLabel}}</text>
            </view>
            <button wx:if="{{syncInfo.family.owner || syncInfo.family.role === 'backup-admin'}}" class="restore-button" data-id="{{item.backupId}}" disabled="{{backupActionId}}" bindtap="restoreFamilyBackup">{{backupActionId === item.backupId ? '恢复中' : '恢复'}}</button>
          </view>
        </view>
      </view>
      <view wx:else>
        <text class="sync-help">目前内容安全保存在这台手机。开启后，记录会同步到你的个人私密云空间。</text>
        <button class="ink-button sync-button" disabled="{{familyActionId}}" loading="{{familyActionId === 'personal-cloud'}}" bindtap="enablePersonalCloudSync">{{familyActionId === 'personal-cloud' ? '正在开启' : '开启个人云同步'}}</button>
      </view>

      <view class="trash-section">
        <view class="backup-heading"><text>最近删除</text><text>保留 30 天</text></view>
        <text wx:if="{{!trashEntries.length}}" class="backup-state">回收站是空的。</text>
        <view wx:for="{{trashEntries}}" wx:key="id" class="trash-item">
          <view class="backup-copy">
            <text class="backup-title">{{item.typeLabel}} · {{item.title}}</text>
            <text class="backup-meta">{{item.deletedLabel}} 删除 · {{item.expiryLabel}}</text>
          </view>
          <button class="restore-button" data-id="{{item.id}}" disabled="{{trashActionId}}" bindtap="restoreTrashEntry">{{trashActionId === item.id ? '恢复中' : '恢复'}}</button>
        </view>
      </view>
      <text wx:if="{{syncInfo.error}}" class="sync-error">云同步暂不可用，记录仍安全保存在本机。</text>
    </scroll-view>
  </view>

  <view wx:if="{{managerOpen}}" class="sheet-mask" bindtap="closeManager">
    <scroll-view class="sheet-panel manager-sheet" scroll-y catchtap="noop">
      <view class="sheet-handle" />
      <view class="sheet-heading"><text>{{managerTitle}}</text><button class="sheet-close" bindtap="closeManager">关闭</button></view>
      <view class="manager-actions"><text class="muted">共 {{managerRecords.length}} 条</text><add-pill primary="{{true}}" bind:add="addFromManager" /></view>
      <view wx:if="{{!managerRecords.length}}" class="empty-state">暂无记录，点 Add 新增。</view>
      <view class="manager-record paper-card" wx:for="{{managerRecords}}" wx:key="id">
        <view class="manager-copy"><text class="manager-primary">{{item.title}}</text><text class="manager-detail">{{item.detail}}</text><text class="manager-note" wx:if="{{item.note}}">{{item.note}}</text></view>
        <view class="manager-buttons">
          <button data-id="{{item.id}}" bindtap="editManagerRecord">编辑</button>
          <button class="delete" data-id="{{item.id}}" bindtap="deleteManagerRecord">删除</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{editorOpen}}" class="sheet-mask" bindtap="closeEditor">
    <scroll-view class="sheet-panel editor-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop">
      <view class="sheet-handle" />
      <view class="sheet-heading"><text>{{editorTitle}}</text><button class="sheet-close" bindtap="closeEditor">关闭</button></view>

      <block wx:if="{{editorKind === 'feeding'}}">
        <view class="field"><text class="field-label">日期 *</text><picker mode="date" value="{{draft.date}}" start="{{birthDate}}" end="{{today}}" data-field="date" bindchange="handleDraftPicker"><view class="field-picker">{{draft.date}}</view></picker></view>
        <view class="field"><text class="field-label">时间 *</text><picker mode="time" value="{{draft.time}}" data-field="time" bindchange="handleDraftPicker"><view class="field-picker">{{draft.time}}</view></picker></view>
        <view class="field"><text class="field-label">奶量 ml *</text><input class="field-input" type="digit" value="{{draft.amount}}" data-field="amount" bindinput="handleDraftInput" placeholder="例如 180" /></view>
        <view class="field"><text class="field-label">喂养类型</text><picker range="{{milkTypes}}" data-field="milkType" data-source="milkTypes" bindchange="handleOptionPicker"><view class="field-picker">{{draft.milkType}}</view></picker></view>
        <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" value="{{draft.note}}" data-field="note" bindinput="handleDraftInput" placeholder="可不填" /></view>
      </block>

      <block wx:elif="{{editorKind === 'sleep'}}">
        <view class="field-grid">
          <view class="field"><text class="field-label">开始日期 *</text><picker mode="date" value="{{draft.startDate}}" start="{{birthDate}}" end="{{today}}" data-field="startDate" bindchange="handleDraftPicker"><view class="field-picker">{{draft.startDate}}</view></picker></view>
          <view class="field"><text class="field-label">开始时间 *</text><picker mode="time" value="{{draft.startTime}}" data-field="startTime" bindchange="handleDraftPicker"><view class="field-picker">{{draft.startTime}}</view></picker></view>
          <view class="field"><text class="field-label">结束日期 *</text><picker mode="date" value="{{draft.endDate}}" start="{{birthDate}}" end="{{today}}" data-field="endDate" bindchange="handleDraftPicker"><view class="field-picker">{{draft.endDate}}</view></picker></view>
          <view class="field"><text class="field-label">结束时间 *</text><picker mode="time" value="{{draft.endTime}}" data-field="endTime" bindchange="handleDraftPicker"><view class="field-picker">{{draft.endTime}}</view></picker></view>
        </view>
        <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" value="{{draft.note}}" data-field="note" bindinput="handleDraftInput" placeholder="例如 午睡" /></view>
      </block>

      <block wx:elif="{{editorKind === 'diaper'}}">
        <view class="field"><text class="field-label">日期 *</text><picker mode="date" value="{{draft.date}}" start="{{birthDate}}" end="{{today}}" data-field="date" bindchange="handleDraftPicker"><view class="field-picker">{{draft.date}}</view></picker></view>
        <view class="field"><text class="field-label">时间 *</text><picker mode="time" value="{{draft.time}}" data-field="time" bindchange="handleDraftPicker"><view class="field-picker">{{draft.time}}</view></picker></view>
        <view class="field"><text class="field-label">尿布状态</text><picker range="{{diaperConditions}}" data-field="condition" data-source="diaperConditions" bindchange="handleOptionPicker"><view class="field-picker">{{draft.condition}}</view></picker></view>
        <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" value="{{draft.note}}" data-field="note" bindinput="handleDraftInput" placeholder="可不填" /></view>
      </block>

      <block wx:elif="{{editorKind === 'poop'}}">
        <view class="field"><text class="field-label">日期 *</text><picker mode="date" value="{{draft.date}}" start="{{birthDate}}" end="{{today}}" data-field="date" bindchange="handleDraftPicker"><view class="field-picker">{{draft.date}}</view></picker></view>
        <view class="field"><text class="field-label">时间 *</text><picker mode="time" value="{{draft.time}}" data-field="time" bindchange="handleDraftPicker"><view class="field-picker">{{draft.time}}</view></picker></view>
        <view class="field"><text class="field-label">便便状态</text><picker range="{{poopStatuses}}" data-field="status" data-source="poopStatuses" bindchange="handleOptionPicker"><view class="field-picker">{{draft.status}}</view></picker></view>
        <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" value="{{draft.note}}" data-field="note" bindinput="handleDraftInput" placeholder="颜色、质地等" /></view>
      </block>

      <block wx:elif="{{editorKind === 'growth'}}">
        <view class="field"><text class="field-label">测量日期 *</text><picker mode="date" value="{{draft.date}}" start="{{birthDate}}" end="{{today}}" data-field="date" bindchange="handleDraftPicker"><view class="field-picker">{{draft.date}}</view></picker></view>
        <view class="field-grid">
          <view class="field"><text class="field-label">体重 kg</text><input class="field-input" type="digit" value="{{draft.weight}}" data-field="weight" bindinput="handleDraftInput" /></view>
          <view class="field"><text class="field-label">身高 cm</text><input class="field-input" type="digit" value="{{draft.height}}" data-field="height" bindinput="handleDraftInput" /></view>
        </view>
        <view class="field"><text class="field-label">成长备注</text><textarea class="field-textarea" value="{{draft.note}}" data-field="note" bindinput="handleDraftInput" placeholder="可不填" /></view>
      </block>

      <block wx:elif="{{editorKind === 'todo'}}">
        <view class="field"><text class="field-label">待办内容 *</text><input class="field-input" value="{{draft.title}}" data-field="title" bindinput="handleDraftInput" focus /></view>
      </block>

      <view class="form-actions"><button class="ink-button" disabled="{{editorSaving}}" loading="{{editorSaving}}" bindtap="saveEditor">{{editorSaving ? '正在保存' : '保存'}}</button></view>
    </scroll-view>
  </view>
</view>
