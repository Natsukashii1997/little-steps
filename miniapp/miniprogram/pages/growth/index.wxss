.page { min-height:100vh; color:#24221e; background:var(--paper) var(--paper-texture) repeat; background-size:360rpx 360rpx; }
.page-scroll { height:100vh; box-sizing:border-box; padding:0 31rpx; }
.hero-card,.section-card { box-sizing:border-box; border:2.3rpx solid #292724; border-radius:34rpx 31rpx 33rpx 30rpx; background:rgba(255,251,241,.64) var(--paper-texture) repeat; background-size:360rpx 360rpx; box-shadow:0 4rpx 0 rgba(69,53,26,.05); }
.profile-card { padding:22rpx 28rpx 14rpx; }
.profile-heading { display:flex; align-items:center; justify-content:space-between; min-height:122rpx; border-bottom:2rpx dashed #c8beae; }
.profile-title { display:block; font-size:35rpx; font-weight:700; }
.profile-age { display:block; margin-top:10rpx; color:#746b5f; font-size:27rpx; }
.bear-mark { width:127rpx; height:117rpx; margin-top:-12rpx; }
.latest-heading { display:flex; justify-content:space-between; align-items:center; margin-top:16rpx; font-size:29rpx; }
.record-source { padding:6rpx 23rpx; border-radius:999rpx; color:#746b5f; background:#ece6d5; font-size:23rpx; line-height:1.3; }
.latest-date { display:block; color:#746b5f; font-size:25rpx; margin-top:4rpx; }
.profile-grid { display:grid; grid-template-columns:1fr 1fr; margin-top:23rpx; }
.profile-cell + .profile-cell { padding-left:31rpx; border-left:1rpx solid #c8beae; }
.metric-label { display:block; color:#746b5f; font-size:27rpx; margin-bottom:4rpx; }
.height-value { color:#3178bc; }
.weight-value { color:#58733d; }
.measurement { font-size:60rpx; line-height:1; }
.unit { font-size:25rpx; margin-left:8rpx; }
.summary-footer { display:flex; justify-content:space-between; align-items:center; min-height:92rpx; margin-top:4rpx; }
.summary-footer > text { color:#746b5f; font-size:25rpx; }
.section-card { margin-top:26rpx; padding:30rpx 28rpx 24rpx; }
.section-heading { display:flex; align-items:center; justify-content:space-between; color:#24221e; }
.section-title { font-size:37rpx; font-weight:700; }
.section-note { color:#746b5f; font-size:24rpx; }
.chart-title { display:flex; align-items:baseline; gap:14rpx; }
.chart-unit { color:inherit; font-size:25rpx; }
.chart-card { height:462rpx; }
.chart-title .section-title { color:#24221e; }
.chart-card .section-heading { color:inherit; }
.chart-plot { position:relative; height:212rpx; margin-top:38rpx; }
.chart-tick { position:absolute; width:100%; height:0; }
.chart-tick > text { position:absolute; left:-2rpx; width:37rpx; text-align:right; color:#746b5f; font-size:23rpx; transform:translateY(-50%); }
.chart-gridline { margin-left:57rpx; width:546rpx; border-top:1rpx dashed #c8beae; }
.chart-tick.is-baseline .chart-gridline { border-top-style:solid; border-top-color:#928675; }
.plot-area { position:absolute; left:57rpx; top:0; width:546rpx; height:212rpx; }
.chart-segment { position:absolute; height:3rpx; background:currentColor; transform-origin:0 50%; }
.chart-point { position:absolute; width:12rpx; height:12rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:50%; background:#fffaf0; transform:translate(-50%,-50%); }
.point-label { position:absolute; left:50%; bottom:23rpx; transform:translateX(-50%); font-size:27rpx; white-space:nowrap; }
.point-label.align-end { left:auto; right:-5rpx; transform:none; }
.point-label.align-start { left:-5rpx; transform:none; }
.chart-date { position:absolute; top:229rpx; transform:translateX(-50%); color:#746b5f; font-size:22rpx; white-space:nowrap; }
.chart-hint { display:block; margin-top:67rpx; text-align:center; color:#746b5f; font-size:25rpx; }
.records-card { padding-bottom:10rpx; }
.records-card > .section-heading { padding-bottom:20rpx; }
.growth-row { border-top:1rpx dashed #c8beae; padding:24rpx 0; }
.record-title-row { display:flex; justify-content:space-between; align-items:center; min-height:40rpx; }
.record-date { font-size:29rpx; font-weight:700; }
.row-arrow { width:32rpx; height:32rpx; }
.record-measurements { display:flex; gap:26rpx; flex-wrap:wrap; margin-top:12rpx; font-size:27rpx; }
.record-note { display:block; margin-top:12rpx; font-size:24rpx; line-height:1.6; color:#746b5f; overflow-wrap:anywhere; white-space:pre-wrap; }
.row-pressed { background:rgba(242,190,98,.12); }
.bottom-space { height:calc(180rpx + env(safe-area-inset-bottom)); }
.modal-mask{
position:fixed;
z-index:100;
inset:0;
background:rgba(31,28,23,.42);
display:flex;
align-items:flex-end}
.editor-sheet{
box-sizing:border-box;
width:100%;
max-height:88vh;
overflow-y:auto;
padding:18rpx 32rpx calc(42rpx + constant(safe-area-inset-bottom));
padding-bottom:calc(42rpx + env(safe-area-inset-bottom));
border:3rpx solid #292724;
border-bottom:0;
border-radius:44rpx 38rpx 0 0;
background:var(--paper) var(--paper-texture) repeat;
background-size:360rpx 360rpx}
.sheet-handle{
width:70rpx;
height:8rpx;
margin:0 auto 18rpx;
border-radius:8rpx;
background:#bdb29d}
.sheet-title-row{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:22rpx}
.sheet-title{
font-size:36rpx;
font-weight:900}
.sheet-close{
width:auto;
min-width:88rpx;
min-height:var(--control-height);
padding:0 12rpx;
background:transparent;
color:#5d574f;
font-size:24rpx;
line-height:82rpx}
.field{
margin-bottom:20rpx}
.field>text{
display:block;
margin:0 0 9rpx;
font-size:25rpx;
font-weight:800}
.field input,.field textarea,.picker-value{
box-sizing:border-box;
width:100%;
min-height:var(--control-height);
padding:19rpx 20rpx;
border:3rpx solid #292724;
border-radius:var(--field-radius);
background:rgba(255,253,248,.82);
font-size:25rpx}
.field textarea{
height:150rpx;
line-height:1.5}
.picker-value{
display:flex;
justify-content:space-between;
align-items:center}
.picker-chevron{
width:30rpx;
height:30rpx;
transform:rotate(90deg)}
.field-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:18rpx}
.save-button,.delete-button{
width:100%;
min-height:var(--control-height);
margin-top:10rpx;
border:3rpx solid #292724;
border-radius:999rpx;
font-size:28rpx;
font-weight:900}
.save-button{
background:#f9c653;
color:#26221b}
.delete-button{
background:#fff0eb;
color:#c85d45}
.birth-lock{
padding:20rpx;
border-radius:var(--field-radius);
background:#f6f0df;
color:#766a54;
font-size:23rpx;
line-height:1.5}


.editor-sheet { max-height:88vh; padding:18rpx 38rpx calc(42rpx + env(safe-area-inset-bottom)); }
.field > text { font-size:27rpx; }
.field input,.field textarea,.picker-value { border-width:2rpx; font-size:31rpx; min-height:92rpx; }
.field input { height:92rpx; }
.field textarea { height:169rpx; }
.field-placeholder { color:#8a8072; }
.save-button { background:#f2be62; min-height:92rpx; }
.sheet-close { font-size:27rpx; }

/* Round 2: reset the app-level heading margins and match the approved sheet rhythm. */
.growth-page .section-title { display:block; margin:0; letter-spacing:0; line-height:1.25; }
.profile-card { padding-bottom:8rpx; }
.hero-card,.section-card { box-shadow:inset 0 0 0 1000rpx rgba(255,251,241,.24),0 4rpx 0 rgba(69,53,26,.05); }
.editor-sheet { min-height:1080rpx; }
.editor-sheet .field { margin-bottom:42rpx; }
.editor-sheet .save-button { margin-top:40rpx; }
