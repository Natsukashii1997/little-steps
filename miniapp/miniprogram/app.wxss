/* V6 拙趣手写｜全局样式。数值来自 docs/design-drafts/2026-10-23-v6-clumsy/authority/tokens.json。
   规范按 390pt 宽写，1pt ≈ 1.923rpx：间距、尺寸用 rpx 随屏宽缩放；字号用 px 保持可读（320 宽也不缩）。
   旧的全局样式（暖色纸纹、卡片）在基线提交 be772db 里。 */
page {
  --paper: #FCFCFC;
  --ink: #111111;
  --ink-2: #707070;
  --blue: #B3CBE0;
  --green: #CFDD97;
  --highlight: #E0EAB8;
  --green-mark: #BDD472;
  --photo-placeholder: #F2F2F2;
  --scrim: rgba(0, 0, 0, 0.5);
  --grabber: #B5B5B5;

  --fs-name: 72px;
  --fs-number: 44px;
  --fs-title: 28px;
  --fs-item: 20px;
  --fs-small: 14px;

  --page-x: 46rpx;        /* 24pt 页面左右边距 */
  --section-gap: 77rpx;   /* 40pt 区块之间 */
  --title-gap: 31rpx;     /* 16pt 区块标题到第一条 */
  --row-min: 85rpx;       /* 44pt 可点的行最小高度 */
  --nav-h: 108rpx;        /* 56pt 底栏 */
  --safe-bottom: constant(safe-area-inset-bottom);
  --safe-bottom: env(safe-area-inset-bottom);

  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: "LXGW WenKai", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-item);
  line-height: 1.5;
}

view,
text,
image,
input,
picker,
button {
  box-sizing: border-box;
}

/* 三级字 */
.title {
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.3;
}

.item {
  font-size: var(--fs-item);
  line-height: 1.5;
}

.small {
  font-size: var(--fs-small);
  line-height: 1.5;
}

.ink2 {
  color: var(--ink-2);
}

/* 页面骨架：纸面、内容区、底栏留白 */
.page {
  min-height: 100vh;
  background: var(--paper);
}

.content {
  padding: 0 var(--page-x) calc(var(--nav-h) + var(--safe-bottom) + var(--section-gap));
}

/* 页头：手写标题在左，插画在右上 */
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 16rpx;
}

.title-art {
  height: 108rpx; /* 墨迹高 56pt */
  flex: 0 0 auto;
}

.section {
  margin-top: var(--section-gap);
}

.section-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 20rpx;
}

.section-spacer {
  flex: 1;
}

.section-body {
  margin-top: var(--title-gap);
}

/* 记录行：左边一句话和小字说明，右边日期；可点的行最小 44pt */
.rec-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  min-height: var(--row-min);
  padding: 8rpx 0;
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-main .item,
.rec-main .small {
  display: block;
}

.rec-text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.rec-main .small {
  margin-top: 4rpx;
}

.rec-date {
  flex: 0 0 auto;
  padding-top: 6rpx;
}

/* 空状态：一张插画加一句话（插画由页头提供时只放文字） */
.empty {
  margin-top: var(--section-gap);
}

.empty .item,
.empty .small {
  display: block;
}

.empty .small {
  margin-top: 8rpx;
}
